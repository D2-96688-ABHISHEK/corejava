package com.app.fruits;

import java.util.Scanner;

public class FruitBasket  {

	public static void main(String[] args) {
	try(Scanner sc = new Scanner(System.in)){
		int choice =0;
		System.out.println("Enter a basket size");
		int size = sc.nextInt();
		Fruit[] fruits= new Fruit[size];
		int counter=0;
		do {
			System.out.println("\n0. Exit");
            System.out.println("1. Add Mango");
            System.out.println("2. Add Orange");
            System.out.println("3. Add Apple");
            System.out.println("4. Display names");
            System.out.println("5. Display fresh fruits");
            System.out.println("6. Display stale fruits taste");
            System.out.println("7. Mark fruit stale");
            System.out.println("8. Mark all sour fruits stale");
            
            System.out.println("Enter choice : ");
            choice = sc.nextInt();
            
            switch(choice) {
            	case 1: if(counter<size) {
            		fruits[counter++]=new Mango("Mango",1.2,"Yellow");
            	}
            	else {
            		System.out.println("Basket is Full ");
            	}
            	break;
            	
            	case 2:if(counter<size) {
            		fruits[counter++]=new Orange("Orange",1.2,"Orange");
            	}
            	else {
            		System.out.println("Basket is Full ");
            	}
            	break;
            	
            	case 3:if(counter<size) {
            		fruits[counter++]=new Apple("Apple",1.2,"Red");
            	}
            	else {
            		System.out.println("Basket is Full ");
            	}
            	break;
            	
            	case 4:
            		for(Fruit f : fruits) {
            			if(f !=null) {
            				f.getName();
            			}
            		}
            		break;
            	case 5:
            		for(Fruit f : fruits) {
            			if(f!=null && f.isFresh) {
            				System.out.println("Taste :" + f.taste());
            			}
            		}
            		break;
            	case 6:
            		for(Fruit f : fruits) {
            			if(f!=null && !f.isFresh) {
            				System.out.println("Taste :" + f.taste());
            			}
            		}
            		break;
            	case 7:
            		System.out.println("Enter index: ");
            		int index;
            		index = sc.nextInt();
            			
            			if(index>0 && index<size&& fruits[index] !=null) {
            				fruits[index].setFresh(false);
            				System.out.println("Marked Stale");
            			}
            			else {
            				System.out.println("Invalid Index");
            			}
            		break;
            	case 8: 
            		for(Fruit f : fruits) {
            			if(f.taste().equals("sour")) {
            				f.setFresh(false);
            			}
            		}
            		System.out.println("All sour fruits are marked Stale");
            		break;
            	}
            
		}while(choice !=0);
	}
		
		
	}
}
